<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent infinite rewrite loops if already in public
    RewriteCond %{REQUEST_URI} ^/public/ [NC]
    RewriteRule ^ - [L]

    # Redirect all non-public requests to the public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
